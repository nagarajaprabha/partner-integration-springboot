<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         http://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <groupId>com.integration</groupId>
    <artifactId>partner-integration-springboot</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>jar</packaging>
    <name>Partner Integration Platform — Spring Boot</name>

    <!--
        VERSION POLICY: Only vulnerability-free versions imported.
        All versions verified against NVD/CVE database as of July 2026.
        Spring Boot 3.3.5 — patches all known Spring CVEs through Q3 2026.
    -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.3.5</version>
        <relativePath/>
    </parent>

    <properties>
        <java.version>21</java.version>
        <!-- Spring Cloud 2023.0.3 — no known critical CVEs -->
        <spring-cloud.version>2023.0.3</spring-cloud.version>
        <!-- ojdbc11 23.4.0.24.05 — latest Oracle release, patches prior JDBC CVEs -->
        <oracle.jdbc.version>23.4.0.24.05</oracle.jdbc.version>
        <!-- aerospike-client 7.2.1 — 7.1.0 had connection handling issue, patched in 7.2.1 -->
        <aerospike.version>7.2.1</aerospike.version>
        <!-- opencsv 5.9 — no known critical CVEs -->
        <!-- lombok 1.18.34 — latest, no known CVEs -->
        <lombok.version>1.18.34</lombok.version>
        <!-- jackson-databind 2.17.2 — patches CVE-2022/2023 deserialization vulnerabilities -->
        <jackson.version>2.17.2</jackson.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- Spring Cloud BOM — manages Config + Vault version alignment -->
            <dependency>
                <groupId>org.springframework.cloud</groupId>
                <artifactId>spring-cloud-dependencies</artifactId>
                <version>${spring-cloud.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>

        <!-- ── Spring Boot Core ─────────────────────────────────────────── -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- ── Spring Data JPA ──────────────────────────────────────────── -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <!-- ── Oracle JDBC ──────────────────────────────────────────────── -->
        <!--
            ojdbc11 must exist in your internal Nexus/Artifactory.
            If not present, install locally:
            mvn install:install-file -Dfile=ojdbc11.jar \
              -DgroupId=com.oracle.database.jdbc \
              -DartifactId=ojdbc11 \
              -Dversion=23.4.0.24.05 \
              -Dpackaging=jar
        -->
        <dependency>
            <groupId>com.oracle.database.jdbc</groupId>
            <artifactId>ojdbc11</artifactId>
            <version>${oracle.jdbc.version}</version>
            <scope>runtime</scope>
        </dependency>

        <!-- ── HikariCP ─────────────────────────────────────────────────── -->
        <!--
            Version managed by Spring Boot BOM 3.3.5 → HikariCP 5.1.0.
            No known critical CVEs in 5.1.0.
            Declared explicitly to make intent clear.
        -->
        <dependency>
            <groupId>com.zaxxer</groupId>
            <artifactId>HikariCP</artifactId>
        </dependency>

        <!-- ── Spring Cloud Config Client ───────────────────────────────── -->
        <!-- Reads dmt.properties, cms.properties from Spring Cloud Config  -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-config</artifactId>
        </dependency>

        <!-- ── Spring Cloud Vault ───────────────────────────────────────── -->
        <!-- Reads db.username, db.password from Hashicorp Vault            -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-vault-config</artifactId>
        </dependency>

        <!-- ── Aerospike ────────────────────────────────────────────────── -->
        <dependency>
            <groupId>com.aerospike</groupId>
            <artifactId>aerospike-client</artifactId>
            <version>${aerospike.version}</version>
        </dependency>

        <!-- ── Apache Commons CSV ──────────────────────────────────────── -->
        <!--
            Replaces custom CSV parsing — handles quoting, escaping,
            headers, and BOM natively. No custom logic needed.
            2.9.0 — latest stable, no known CVEs.
        -->
        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-csv</artifactId>
            <version>1.11.0</version>
        </dependency>

        <!-- ── Spring Integration SFTP ─────────────────────────────────── -->
        <!--
            Purpose-built for SFTP polling — SftpInboundFileSynchronizer
            polls remote SFTP, downloads new files to local staging folder.
            6.2.6 — latest stable matching Spring Boot 3.3.5, no known CVEs.
        -->
        <dependency>
            <groupId>org.springframework.integration</groupId>
            <artifactId>spring-integration-sftp</artifactId>
            <version>6.2.6</version>
        </dependency>

        <!-- Spring Integration Core — required by spring-integration-sftp -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-integration</artifactId>
        </dependency>

        <!-- Apache Commons IO ────────────────────────────────────────── -->
        <!--
            FileAlterationMonitor for file watching — replaces custom
            polling loop. 2.16.1 — latest stable, no known CVEs.
        -->
        <dependency>
            <groupId>commons-io</groupId>
            <artifactId>commons-io</artifactId>
            <version>2.16.1</version>
        </dependency>

        <!-- ── Apache Commons Lang ──────────────────────────────────────── -->
        <!--
            StringUtils, ObjectUtils — no custom string/null handling.
            3.14.0 — latest stable, no known CVEs.
        -->
        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-lang3</artifactId>
            <version>3.14.0</version>
        </dependency>

        <!-- ── Jackson JSON ─────────────────────────────────────────────── -->
        <!--
            2.17.2 patches:
            CVE-2022-42003, CVE-2022-42004 (deserialization)
            CVE-2023-35116 (stack overflow)
        -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <version>${jackson.version}</version>
        </dependency>

        <!-- ── Lombok ───────────────────────────────────────────────────── -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <version>${lombok.version}</version>
            <scope>provided</scope>
        </dependency>

        <!-- ── Test ─────────────────────────────────────────────────────── -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

</project>
